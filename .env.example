# ── Entorno ─────────────────────────────────────────────
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# ── Base de datos ───────────────────────────────────────
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
# Solo producción (compose.prod.yml):
POSTGRES_USER=crm
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=crm

# ── Seguridad ───────────────────────────────────────────
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                # true en producción (HTTPS)
CORS_ORIGINS=["http://localhost:5173"]

# ── Administrador inicial (se crea solo si no existe) ───
INITIAL_ADMIN_EMAIL=admin@dataservice.pe
INITIAL_ADMIN_PASSWORD=Admin123!
INITIAL_ADMIN_NAME=Administrador del sistema

# ── Producción ──────────────────────────────────────────
DOMAIN=crm.tu-dominio.pe
LETSENCRYPT_EMAIL=sistemas@tu-dominio.pe
